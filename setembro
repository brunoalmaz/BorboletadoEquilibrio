<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Borboleta · Índex</title>
<style>
  /* Layout: horizontal scroll-snapped full-screen sections (swipe/scroll sideways through the report). Strict monochrome palette, grounded in the real profile: black circle, white line art, or the inverse in light mode. No accent color. */
  :root{
    --bg:#070707; --card:#131313; --line:#2a2a2a;
    --fg:#ffffff; --fg-dim:#c7c7c7; --fg-faint:#848484;
    --pos:#3ddc8d; --neg:#f3665f;
    color-scheme:dark;
    --display:'Cormorant Garamond',Georgia,'Times New Roman',serif;
    --body:'Jost','Helvetica Neue',Arial,sans-serif;
  }
  :root[data-theme="light"]{
    --bg:#ffffff; --card:#f1f1f1; --line:#dcdcdc;
    --fg:#090909; --fg-dim:#3c3c3c; --fg-faint:#767676;
    --pos:#0f9d64; --neg:#d6392f;
    color-scheme:light;
  }

  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0; background:var(--bg); color:var(--fg);
    font-family:var(--body); -webkit-font-smoothing:antialiased;
    overflow:hidden;
  }
  h1,h2,h3{font-family:var(--display); font-weight:500; margin:0}
  p{margin:0}
  .num{font-variant-numeric:tabular-nums}
  .pos{color:var(--pos) !important; font-weight:500}
  .neg{color:var(--neg) !important; font-weight:500}
  a{color:inherit}

  #scroller{
    height:100dvh; width:100vw; overflow-x:auto; overflow-y:hidden;
    scroll-snap-type:x mandatory; display:flex; flex-direction:row;
    -webkit-overflow-scrolling:touch;
  }
  @media (prefers-reduced-motion:reduce){ #scroller{ scroll-snap-type:none } }

  section.screen{
    flex:0 0 100vw; width:100vw; height:100dvh;
    scroll-snap-align:start; scroll-snap-stop:always;
    display:flex; flex-direction:column; justify-content:center;
    padding:clamp(28px,5vw,80px) clamp(24px,7vw,120px);
    position:relative; border-right:1px solid var(--line);
    overflow-y:auto;
  }
  .inner{max-width:1180px; margin:0 auto; width:100%}
  section.screen.content{justify-content:flex-start; padding-top:clamp(108px,17vh,170px)}
  section.screen.content .inner{display:flex; flex-direction:column; flex:1; min-height:0; padding-bottom:clamp(28px,5vh,64px)}

  /* ---- reveal motion ---- */
  .reveal{opacity:0; transform:translateY(22px) scale(.98); transition:opacity .8s cubic-bezier(.16,.8,.3,1), transform .8s cubic-bezier(.16,.8,.3,1)}
  .reveal.in{opacity:1; transform:translateY(0) scale(1)}
  .reveal.d1{transition-delay:.08s} .reveal.d2{transition-delay:.16s}
  .reveal.d3{transition-delay:.24s} .reveal.d4{transition-delay:.32s}
  @media (prefers-reduced-motion:reduce){ .reveal{opacity:1; transform:none; transition:none} }

  /* ---- staggered children inside grids/lists: cascade in on top of the parent reveal ---- */
  .tiles .tile, .steps .step, .notes .note, .preview-grid .preview, .link-cards a{
    opacity:0; transform:translateY(16px);
    transition:opacity .65s cubic-bezier(.16,.8,.3,1), transform .65s cubic-bezier(.16,.8,.3,1), border-color .3s, box-shadow .3s;
  }
  .tiles.in .tile, .steps.in .step, .notes.in .note, .preview-grid.in .preview, .link-cards.in a{ opacity:1; transform:translateY(0) }
  .tiles .tile:nth-child(1), .steps .step:nth-child(1), .notes .note:nth-child(1), .preview-grid .preview:nth-child(1), .link-cards a:nth-child(1){transition-delay:.06s}
  .tiles .tile:nth-child(2), .steps .step:nth-child(2), .notes .note:nth-child(2), .preview-grid .preview:nth-child(2), .link-cards a:nth-child(2){transition-delay:.13s}
  .tiles .tile:nth-child(3), .steps .step:nth-child(3), .notes .note:nth-child(3), .preview-grid .preview:nth-child(3), .link-cards a:nth-child(3){transition-delay:.20s}
  .tiles .tile:nth-child(4), .steps .step:nth-child(4), .notes .note:nth-child(4){transition-delay:.27s}
  .tiles .tile:nth-child(5), .steps .step:nth-child(5){transition-delay:.34s}
  .tiles .tile:nth-child(6){transition-delay:.41s}
  @media (prefers-reduced-motion:reduce){
    .tiles .tile, .steps .step, .notes .note, .preview-grid .preview, .link-cards a{ opacity:1; transform:none; transition:none }
  }

  /* ---- ambient drifting backdrop: faint diagonal grid, always slowly alive ---- */
  body::before{
    content:""; position:fixed; inset:-20vmax; z-index:0; pointer-events:none;
    background-image:
      repeating-linear-gradient(45deg, var(--line) 0, var(--line) 1px, transparent 1px, transparent 64px),
      repeating-linear-gradient(-45deg, var(--line) 0, var(--line) 1px, transparent 1px, transparent 64px);
    opacity:.16;
    animation:driftgrid 50s linear infinite;
    will-change:transform;
  }
  @keyframes driftgrid{ 0%{transform:translate(0,0)} 100%{transform:translate(64px,64px)} }
  @media (prefers-reduced-motion:reduce){ body::before{animation:none} }
  section.screen, nav.dots, #progress{ position:relative; z-index:1 }

  /* ---- brand watermark: the thyroid-shaped mark, always softly alive behind the content ---- */
  #bgmark{
    position:fixed; inset:0; z-index:0; display:flex; align-items:center; justify-content:center;
    pointer-events:none; opacity:.05;
  }
  #bgmark img{ width:min(52vmin,560px); height:auto; animation:bgbreathe 9s ease-in-out infinite }
  @keyframes bgbreathe{
    0%,100%{ transform:scale(1) rotate(-1.5deg); opacity:.7 }
    50%{ transform:scale(1.045) rotate(1.5deg); opacity:1 }
  }
  @media (prefers-reduced-motion:reduce){ #bgmark img{ animation:none } }

  /* ---- heartline: a continuous vital-sign pulse, the health side of the brand always visibly alive ---- */
  #heartline{
    position:fixed; top:2px; left:0; width:100%; height:22px; z-index:35;
    overflow:hidden; pointer-events:none; opacity:.4;
  }
  #heartline svg{ width:100%; height:100%; display:block }
  #heartline path{ fill:none; stroke:var(--fg-faint); stroke-width:2; vector-effect:non-scaling-stroke }
  @media (prefers-reduced-motion:reduce){ #heartline{ display:none } }
  @media (max-width:680px){ #heartline{ display:none } }

  /* ---- progress bar ---- */
  #progress{position:fixed; top:0; left:0; height:2px; background:var(--fg); width:0%; z-index:40; transition:width .1s linear; box-shadow:0 0 10px 1px var(--fg)}

  /* ---- dot nav ---- */
  nav.dots{
    position:fixed; left:50%; bottom:clamp(14px,3vh,32px); transform:translateX(-50%);
    z-index:30; display:flex; flex-direction:row; gap:14px; align-items:center;
  }
  nav.dots button{all:unset; cursor:pointer; display:flex; align-items:center; position:relative}
  nav.dots .dot{width:6px; height:6px; border-radius:50%; background:var(--fg-faint); transition:all .3s}
  nav.dots button.active .dot{background:var(--fg); width:22px; border-radius:4px}
  nav.dots button.active .dot::after{
    content:""; position:absolute; inset:-6px; border:1px solid var(--fg); border-radius:8px;
    opacity:0; animation:dotping 1.6s ease-out infinite;
  }
  @keyframes dotping{0%{opacity:.55; transform:scale(.85)} 100%{opacity:0; transform:scale(1.5)}}
  @media (prefers-reduced-motion:reduce){ nav.dots button.active .dot::after{animation:none; display:none} }

  /* ---- butterfly motif ---- */
  .wing{animation:breathe 7s ease-in-out infinite}
  @keyframes breathe{0%,100%{transform:scale(1); opacity:.85} 50%{transform:scale(1.035); opacity:1}}
  @media (prefers-reduced-motion:reduce){ .wing{animation:none} }

  /* ---- hero / capa ---- */
  #hero{background:radial-gradient(560px circle at var(--mx,50%) var(--my,38%), color-mix(in srgb, var(--fg) 7%, transparent), transparent 62%); transition:background-position .2s}
  .tag-corner{position:absolute; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--fg-faint)}
  .cat{top:clamp(28px,5vw,64px); left:clamp(24px,7vw,120px)}
  .client{top:clamp(28px,5vw,64px); right:clamp(24px,7vw,120px); text-align:right}
  .cover-title{font-size:clamp(12px,1.6vw,16px); font-weight:500; letter-spacing:.24em; text-transform:uppercase; color:var(--fg-faint); font-family:var(--body)}
  .cover-month{
    font-family:var(--display); font-size:clamp(44px,8.5vw,108px); font-weight:500; line-height:.94; margin-top:16px;
    background:linear-gradient(100deg, var(--fg) 30%, var(--fg-faint) 42%, var(--fg) 54%);
    background-size:260% 100%; -webkit-background-clip:text; background-clip:text; color:transparent;
    animation:shimmer 7s ease-in-out infinite;
  }
  .cover-month i{font-style:italic}
  @keyframes shimmer{0%{background-position:0% 0} 50%{background-position:100% 0} 100%{background-position:0% 0}}
  @media (prefers-reduced-motion:reduce){ .cover-month{animation:none; background:none; color:var(--fg)} }
  .swipe-cue{position:absolute; right:clamp(24px,7vw,120px); bottom:clamp(28px,5vh,56px); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--fg-faint); display:flex; align-items:center; gap:12px}
  .swipe-cue .chev{display:flex; gap:2px}
  .swipe-cue .chev span{width:6px; height:6px; border-top:1.4px solid var(--fg-faint); border-right:1.4px solid var(--fg-faint); transform:rotate(45deg); animation:nudge 1.8s ease-in-out infinite}
  .swipe-cue .chev span:nth-child(2){animation-delay:.15s}
  .swipe-cue .chev span:nth-child(3){animation-delay:.3s}
  @keyframes nudge{0%,100%{opacity:.25; transform:translateX(0) rotate(45deg)} 50%{opacity:1; transform:translateX(5px) rotate(45deg)}}
  @media (prefers-reduced-motion:reduce){ .swipe-cue .chev span{animation:none; opacity:.7} }

  /* ---- section heading ---- */
  .kicker{display:flex; align-items:center; gap:14px; margin-bottom:22px}
  .kn{font-size:12px; border:1px solid var(--line); padding:5px 9px; letter-spacing:.06em; color:var(--fg-dim); position:relative}
  .kn::before{
    content:""; position:absolute; inset:-5px; border:1px solid var(--line); border-radius:2px;
    animation:kicktick 3.4s ease-in-out infinite;
  }
  @keyframes kicktick{0%,100%{opacity:0; transform:scale(1)} 50%{opacity:1; transform:scale(1.08)}}
  @media (prefers-reduced-motion:reduce){ .kn::before{animation:none; display:none} }
  .kt{font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--fg-faint)}
  .heading{font-size:clamp(28px,4vw,46px)}
  .dek{color:var(--fg-dim); font-size:15px; max-width:95ch; margin-top:14px; line-height:1.7; font-weight:300}

  /* ---- stat tiles ---- */
  .tiles{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); grid-auto-rows:1fr; gap:1px; background:var(--line); border:1px solid var(--line); margin-top:32px; flex:1}
  .tile{background:var(--card); padding:28px 22px; min-width:0; display:flex; flex-direction:column; justify-content:flex-start}
  .tile .ti{width:21px; height:21px; color:var(--fg-faint); flex-shrink:0}
  .tile .vl{flex:1; display:flex; flex-direction:column; justify-content:center}
  .tile .v{font-family:var(--display); font-size:clamp(26px,3.4vw,40px); font-weight:500; line-height:1; white-space:nowrap}
  .tile .l{color:var(--fg-dim); font-size:13px; margin-top:10px; line-height:1.4}
  .tile .d{font-size:12.5px; margin-top:auto; padding-top:14px; font-weight:500; letter-spacing:.03em; color:var(--fg-faint)}
  .tile.flag{outline:1px solid var(--fg)}
  .tiles .tile:hover{background:var(--line); transform:translateY(-3px); transition-duration:.3s}

  /* ---- traffic sources ---- */
  .sources{display:flex; flex-direction:column; justify-content:space-evenly; gap:16px; margin-top:26px; max-width:720px; flex:1}
  .source-row{
    display:grid; grid-template-columns:120px 1fr auto; gap:16px; align-items:center;
    opacity:0; transform:translateX(-10px); transition:opacity .6s cubic-bezier(.16,.8,.3,1), transform .6s cubic-bezier(.16,.8,.3,1);
  }
  .source-row.in{opacity:1; transform:translateX(0)}
  .source-row:nth-child(1){transition-delay:.05s} .source-row:nth-child(1) .fill{transition-delay:.15s}
  .source-row:nth-child(2){transition-delay:.15s} .source-row:nth-child(2) .fill{transition-delay:.25s}
  .source-row:nth-child(3){transition-delay:.25s} .source-row:nth-child(3) .fill{transition-delay:.35s}
  @media (prefers-reduced-motion:reduce){ .source-row{opacity:1; transform:none} }
  .source-row .name{font-size:13px; color:var(--fg-dim)}
  .source-row .track{height:4px; background:var(--card); overflow:hidden}
  .source-row .fill{height:100%; width:0%; background:var(--fg); transition:width 1.3s cubic-bezier(.16,.8,.3,1)}
  .source-row.in .fill{width:var(--w)}
  .source-row .val{font-size:13px; white-space:nowrap; color:var(--fg-faint)}
  .source-row .val b{font-family:var(--display); font-size:17px; font-weight:500; color:var(--fg)}

  /* ---- content previews ---- */
  .preview-grid{display:grid; grid-template-columns:repeat(3,1fr); grid-auto-rows:1fr; gap:22px; margin-top:30px; flex:1; min-height:260px}
  .preview{background:var(--card); border:1px solid var(--line); text-decoration:none; color:inherit; display:flex; flex-direction:column; min-height:0}
  .preview .open{font-size:11px; color:var(--fg-faint); letter-spacing:.06em; margin-top:12px; padding-top:12px; border-top:1px solid var(--line); transition:color .3s}
  .preview:hover .open{color:var(--fg)}
  .frame{flex:1; min-height:80px; border-bottom:1px solid var(--line); position:relative; overflow:hidden}
  .frame img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; transition:transform .7s cubic-bezier(.16,.8,.3,1), filter .7s; filter:grayscale(.25)}
  .frame .tag{position:absolute; top:12px; left:12px; font-size:10px; letter-spacing:.08em; text-transform:uppercase; padding:3px 9px; border:1px solid var(--line); background:var(--bg); color:var(--fg-dim); z-index:2}
  .preview-grid .preview:hover .frame img{transform:scale(1.08); filter:grayscale(0)}
  .preview-grid .preview:hover{transition-duration:.3s}
  .pbody{padding:22px; display:flex; flex-direction:column; flex-shrink:0}
  .pbody .cap{font-size:14px; color:var(--fg); line-height:1.4}
  .pstats{display:flex; gap:16px; margin-top:14px; padding-top:14px; border-top:1px solid var(--line)}
  .pstats div{display:flex; flex-direction:column; gap:2px}
  .pstats .v{font-family:var(--display); font-size:19px}
  .pstats .l{font-size:10px; color:var(--fg-faint); text-transform:uppercase; letter-spacing:.05em}
  .preview-note{font-size:12.5px; color:var(--fg-faint); margin-top:18px; line-height:1.6; max-width:70ch}

  .link-cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); grid-auto-rows:1fr; gap:14px; margin-top:28px; flex:1}
  .link-cards a{display:flex; flex-direction:column; justify-content:center; text-decoration:none; padding:34px 28px; background:var(--card); border:1px solid var(--line); transition:transform .3s, border-color .3s}
  .link-cards a:hover{transform:translateY(-4px); border-color:var(--fg)}
  .link-cards .k{color:var(--fg-faint); font-size:11px; letter-spacing:.1em; text-transform:uppercase}
  .link-cards .t{font-family:var(--display); font-size:22px; margin-top:10px; color:var(--fg)}
  .link-cards .u{color:var(--fg-faint); font-size:12px; margin-top:10px; overflow-wrap:anywhere}

  /* ---- steps ---- */
  .steps{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); grid-auto-rows:1fr; gap:1px; background:var(--line); border:1px solid var(--line); margin-top:30px; flex:1}
  .step{background:var(--card); padding:34px 30px; display:flex; flex-direction:column; justify-content:flex-start}
  .step .n{font-family:var(--display); font-size:28px; line-height:1; color:var(--fg-faint)}
  .step h3{font-size:16px; font-weight:500; margin-top:12px}
  .step p{font-size:12.5px; color:var(--fg-dim); line-height:1.65; margin-top:8px; font-weight:300}
  .step .ctrl{margin-top:auto; padding-top:14px; border-top:1px solid var(--line); font-size:11px; color:var(--fg-faint)}
  .step .ctrl b{display:block; color:var(--fg-dim); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; font-weight:500; margin-bottom:5px}
  .steps .step:hover{background:var(--line); transform:translateY(-3px); transition-duration:.3s}

  /* ---- ads (campanhas pagas) ---- */
  .ads-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); grid-auto-rows:1fr; gap:1px; background:var(--line); border:1px solid var(--line); margin-top:30px; flex:1}
  .adcard{background:var(--card); padding:30px 28px; display:flex; flex-direction:column; justify-content:flex-start; gap:18px}
  .adcard .ahead{display:flex; align-items:center; justify-content:space-between; gap:12px}
  .adcard .aname{font-family:var(--display); font-size:21px; color:var(--fg)}
  .adcard .astate{font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--fg-faint); border:1px solid var(--line); padding:4px 9px; white-space:nowrap; display:flex; align-items:center; gap:6px}
  .adcard .astate .dotlive{width:6px; height:6px; border-radius:50%; background:var(--pos)}
  .adcard .arow{display:flex; gap:28px; flex-wrap:wrap}
  .adcard .arow div{display:flex; flex-direction:column; gap:4px}
  .adcard .arow .v{font-family:var(--display); font-size:22px}
  .adcard .arow .l{font-size:10.5px; color:var(--fg-faint); text-transform:uppercase; letter-spacing:.05em}
  .adcard .anote{font-size:12px; color:var(--fg-dim); line-height:1.6; padding-top:14px; border-top:1px solid var(--line); font-weight:300; margin-top:auto}
  .ads-foot{font-size:12px; color:var(--fg-faint); margin-top:18px}

  /* ---- notes ---- */
  .notes{display:flex; flex-direction:column; gap:1px; background:var(--line); border:1px solid var(--line); margin-top:28px; max-width:980px; flex:1}
  .note{background:var(--card); padding:26px 28px; display:flex; gap:18px; align-items:center; flex:1}
  .note .mk{font-family:var(--display); font-style:italic; font-size:19px; flex-shrink:0; color:var(--fg-faint)}
  .note p{font-size:13px; color:var(--fg-dim); line-height:1.65; font-weight:300}
  .note b{color:var(--fg); font-weight:600}
  .notes .note:hover{background:var(--line); transition-duration:.3s}
  .notes.compact{margin-top:20px}
  .notes.compact .note{padding:13px 26px; gap:16px; justify-content:space-between}
  .notes.compact .note p{font-size:12.5px; line-height:1.5; flex:1}
  .notes.compact .mk{font-size:16px}

  /* ---- compact steps: dense 2x2 pitch card grid for proposal sections ---- */
  .steps.compact{grid-template-columns:repeat(2,1fr); margin-top:20px}
  .steps.compact .step{padding:16px 20px}
  .steps.compact .step .n{font-size:18px}
  .steps.compact .step h3{font-size:13.5px; margin-top:5px}
  .steps.compact .step p{font-size:11.5px; margin-top:5px; line-height:1.45}
  .steps.compact .step .ctrl{padding-top:9px; margin-top:8px}
  .steps.compact .step .ctrl b{font-size:9.5px; margin-bottom:3px}
  @media (max-width:680px){ .steps.compact{grid-template-columns:1fr} }
  .notes.compact .note.done p{color:var(--fg-faint)}
  .notes.compact .note.done .mk{color:var(--pos); opacity:.6}
  .chk{font-size:10px; letter-spacing:.08em; text-transform:uppercase; padding:5px 11px; border:1px solid var(--line); white-space:nowrap; display:flex; align-items:center; gap:7px; flex-shrink:0}
  .chk .d{width:6px; height:6px; border-radius:50%; flex-shrink:0}
  .chk.done{color:var(--pos); border-color:color-mix(in srgb, var(--pos) 40%, var(--line))}
  .chk.done .d{background:var(--pos)}
  .chk.open{color:var(--fg-faint)}
  .chk.open .d{background:var(--fg-faint)}

  /* ---- fechamento ---- */
  .logo-mark{display:flex; align-items:center; gap:18px}
  .logo-word{font-family:var(--display); font-size:clamp(46px,8vw,96px); font-weight:500; letter-spacing:.01em}
  .logo-word b{font-weight:600}
  .close-grid{display:flex; gap:48px; flex-wrap:wrap; margin-top:56px; font-size:11.5px; color:var(--fg-faint); letter-spacing:.1em; text-transform:uppercase}
  .close-grid b{display:block; color:var(--fg); font-size:16px; font-weight:500; margin-top:6px; letter-spacing:0; text-transform:none; font-family:var(--body)}

  @media (max-width:680px){
    nav.dots{display:none}
    section.screen.content{padding-top:clamp(64px,9vh,108px)}
    .kicker{margin-bottom:12px}
    .heading{font-size:clamp(22px,6vw,32px)}
    .dek{margin-top:8px}
    .notes.compact{margin-top:12px}
    .notes.compact .note{padding:9px 18px; gap:12px}
    .notes.compact .note p{font-size:12px; line-height:1.42}
    .notes.compact .mk{font-size:14px}
  }

  /* ---- short viewports: compact vertical rhythm so taller lists (checklist) don't get eaten by scroll-snap ---- */
  @media (max-height:700px){
    section.screen.content{padding-top:clamp(64px,9vh,108px)}
    .kicker{margin-bottom:12px}
